{
  "sourceLanguage": "en",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "comment": "Privacy - System Audio Recording usage description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lautstärkemixer gibt jede App mit der Lautstärke und über die Ausgabe wieder, die du dafür auswählst. Es wird nichts aufgenommen oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume mixer plays each app at the volume and on the output you choose for it. Nothing is recorded or kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音量ミキサーは、各アプリの音声を選択した音量と出力で再生します。録音や保存は一切行いません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микшер громкости выводит каждое приложение с той громкостью и на тот выход, что вы для него выбрали. Ничего не записывается и не сохраняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量合成器会以你为每个App选择的音量和输出播放其声音。不会录制或保留任何内容。"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription": {
      "comment": "Shown by macOS when New File first writes in this folder",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweakly erstellt die neuen Dateien, die du mit „Neue Datei“ im Kontextmenü des Finders anforderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweakly makes the new files you ask for with New File in Finder’s shortcut menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderのショートカットメニューで“新規ファイル”を選択したときに、Tweaklyが新しいファイルを作成します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweakly создаёт новые файлы, когда вы выбираете «Новый файл» в контекстном меню Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你在访达快捷菜单中选择“新建文件”时，Tweakly会创建新文件。"
          }
        }
      }
    },
