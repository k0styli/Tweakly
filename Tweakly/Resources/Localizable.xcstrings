    "Without Screen Recording the tiles show app icons instead of previews.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Bildschirmaufnahme zeigen die Kacheln App-Symbole statt Vorschauen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録が許可されていない場合、タイルにはプレビューの代わりにアプリのアイコンが表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без записи экрана на плитках будут значки приложений вместо превью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有录屏权限时，缩略图将显示App图标而不是预览。"
          }
        }
      }
    },
    "Without the data in its containers, which needs Full Disk Access": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne die Daten in ihren Containern, dafür ist Festplattenvollzugriff nötig"
