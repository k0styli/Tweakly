          "stringUnit": {
            "state": "translated",
            "value": "このショートカットはシステムの“強制終了”ウインドウを開きます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание открывает системное окно принудительного завершения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷键会打开系统的“强制退出”窗口。"
