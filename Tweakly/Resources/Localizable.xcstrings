    "In the middle, the speed macOS gives the mouse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Mitte: die Geschwindigkeit, die macOS für die Maus vorsieht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央は、macOSがマウスに設定している速度です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посередине — скорость, которую мыши даёт macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
