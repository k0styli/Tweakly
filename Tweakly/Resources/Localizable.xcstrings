    "Less frequent updates use less energy. Low Power Mode slows them down further.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seltenere Aktualisierungen verbrauchen weniger Energie. Im Stromsparmodus erfolgen sie noch seltener."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新頻度を下げると消費電力が少なくなります。低電力モードではさらに頻度が下がります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем реже обновления, тем меньше расход энергии. В режиме энергосбережения они становятся ещё реже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新频率越低越节省能耗。低电量模式下更新频率会进一步降低。"
          }
        }
      }
    },
