    "The input device and its volume, below the apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Eingabegerät und seine Lautstärke, unter den Apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力装置とその音量をアプリの下に表示します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство ввода и его громкость, под приложениями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入设备及其音量，显示在App下方。"
          }
        }
      }
    },
    "The volume of each app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine eigene Lautstärke für jede App."
          }
        },
        "ja": {
