    "Dock Previews": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-Vorschauen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockプレビュー"
          }
        },
        "ru": {
