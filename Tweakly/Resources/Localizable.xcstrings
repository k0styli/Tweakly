    "Number beside icon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahl neben Symbol"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンの横に数値"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок и число сбоку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
