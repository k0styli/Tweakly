          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建文件"
          }
        }
      }
    },
    "Copy Path": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfad kopieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスをコピー"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать путь"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝路径"
          }
        }
      }
    },
    "Open in Terminal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Terminal öffnen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ターミナル”で開く"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть в Терминале"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端中打开"
          }
        }
      }
    },
    "In an empty part of a folder or the desktop. Makes an empty text file to name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An einer leeren Stelle eines Ordners oder des Schreibtischs. Erstellt eine leere Textdatei, die du benennen kannst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダまたはデスクトップの何もない場所で使用します。空のテキストファイルを作成し、名前を入力できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На пустом месте папки или рабочего стола. Создаёт пустой текстовый файл и сразу даёт его назвать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在文件夹或桌面的空白处使用。创建一个空文本文件并让你命名。"
          }
        }
      }
    },
    "The full path of what you clicked, one a line for several items.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vollständige Pfad des angeklickten Objekts, bei mehreren Objekten einer pro Zeile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックした項目のフルパスです。複数の項目の場合は、1行に1つずつコピーされます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный путь к объекту, а для нескольких по пути в строке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所点按项目的完整路径；多个项目时每行一个。"
          }
        }
      }
    },
    "A Terminal window in the folder you clicked, or in the one that holds the file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Terminal-Fenster im angeklickten Ordner oder in dem Ordner, der die Datei enthält."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックしたフォルダ、またはファイルがあるフォルダでターミナルウインドウを開きます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно Терминала в этой папке или в папке, где лежит файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你点按的文件夹或包含该文件的文件夹中打开终端窗口。"
          }
        }
      }
    },
    "Items": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пункты"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目"
          }
        }
      }
    },
    "What a right click in Finder adds to its menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ein Rechtsklick im Finder zu seinem Menü hinzufügt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderで右クリックしたときのメニューに追加される項目です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что появится в меню по правому клику в Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中右键点按时添加到菜单中的项目。"
          }
        }
      }
    },
    "Finder Extension": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder-Erweiterung"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder機能拡張"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达扩展"
          }
        }
      }
    },
    "Turn On": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにする"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        }
      }
    },
    "Off in Login Items & Extensions, so Finder shows none of these items.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In „Anmeldeobjekte & Erweiterungen“ ausgeschaltet, daher zeigt der Finder keines dieser Objekte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ログイン項目と機能拡張”でオフになっているため、Finderにはこれらの項目が表示されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено в разделе «Объекты входа и расширения», поэтому Finder не показывает эти пункты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在“登录项与扩展”中关闭，因此访达不显示这些项目。"
          }
        }
      }
    },
    "Login Items & Extensions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldeobjekte & Erweiterungen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目と機能拡張"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты входа и расширения"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录项与扩展"
          }
        }
      }
    },
    "What macOS allows Tweakly to do. Tweakly asks for a permission only when you turn on a feature that needs it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was macOS Tweakly erlaubt. Tweakly fragt nach einer Berechtigung nur, wenn du eine Funktion einschaltest, die sie braucht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがTweaklyに許可していること。Tweaklyは、許可が必要な機能をオンにしたときにだけ許可を求めます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что macOS разрешает Tweakly. Tweakly просит разрешение, только когда вы включаете функцию, которой оно нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS允许Tweakly执行的操作。只有在你打开需要某项权限的功能时，Tweakly才会请求该权限。"
          }
        }
      }
    },
    "The File Could Not Be Created": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht erstellt werden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを作成できませんでした"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать файл"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建文件"
          }
        }
      }
    },
    "Tweakly has no access to “%@”. You can allow it in Privacy & Security, Files & Folders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweakly hat keinen Zugriff auf „%@“. Du kannst ihn unter „Datenschutz & Sicherheit“ > „Dateien & Ordner“ erlauben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweaklyには“%@”へのアクセス権がありません。“プライバシーとセキュリティ”の“ファイルとフォルダ”で許可できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Tweakly нет доступа к «%@». Его можно разрешить в разделе «Конфиденциальность и безопасность» → «Файлы и папки»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweakly无权访问“%@”。你可以在“隐私与安全”的“文件与文件夹”中允许访问。"
          }
        }
      }
    },
    "Open Privacy & Security": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Datenschutz & Sicherheit“ öffnen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“プライバシーとセキュリティ”を開く"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть «Конфиденциальность и безопасность»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“隐私与安全”"
          }
        }
      }
    },
    "Turned off: this version of macOS does not let Tweakly answer the Finder extension.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet: Diese Version von macOS lässt Tweakly nicht auf die Finder-Erweiterung antworten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのmacOSではTweaklyがFinder機能拡張に応答できないため、オフにしました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: эта версия macOS не даёт Tweakly отвечать расширению Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭：此版本的macOS不允许Tweakly响应访达扩展。"
          }
        }
      }
    },
    "Turned off: the Finder extension inside Tweakly is missing or damaged. Install Tweakly again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet: Die Finder-Erweiterung in Tweakly fehlt oder ist beschädigt. Installiere Tweakly erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweakly内のFinder機能拡張が見つからないか破損しているため、オフにしました。Tweaklyをもう一度インストールしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: расширение Finder внутри Tweakly отсутствует или повреждено. Установите Tweakly заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭：Tweakly中的访达扩展缺失或已损坏。请重新安装Tweakly。"
          }
        }
      }
    },
    "Turned off: another copy of Tweakly was answering Finder. Quit it and turn this on again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet: Eine andere Kopie von Tweakly hat dem Finder bereits geantwortet. Beende sie und schalte es wieder ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweaklyの別のコピーがFinderに応答していたため、オフにしました。そのコピーを終了してから、もう一度オンにしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: Finder уже отвечала другая копия Tweakly. Закройте её и включите снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭：另一个Tweakly副本正在响应访达。请将其退出，然后重新打开此功能。"
          }
        }
      }
    },
    "Right Click": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右クリック"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правый клик"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按"
          }
        }
      }
    },
    "Shortcut Menu": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontextmenü"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットメニュー"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекстное меню"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷菜单"
          }
        }
      }
    },
    "“%@” was moved to the Trash: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde in den Papierkorb gelegt: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”をゴミ箱に入れました：%@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%1$@» перемещено в Корзину: %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已移到废纸篓：%@。"
          }
        }
      }
    },
    "“%@” could not be moved to the Trash, so nothing else was.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht in den Papierkorb gelegt werden, daher wurde auch nichts anderes dorthin gelegt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”をゴミ箱に入れられなかったため、ほかの項目もそのままにしました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%@» не удалось переместить в Корзину, поэтому всё остальное осталось на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将“%@”移到废纸篓，因此其他项目也未移动。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
