    "Otherwise it takes the menu bar's one color, as the system's icons do.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andernfalls übernimmt es die einheitliche Farbe der Menüleiste, wie die Symbole des Systems."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合は、システムのアイコンと同じようにメニューバーの単色になります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе он будет одного цвета со строкой меню, как системные значки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则它将采用菜单栏的单一颜色，与系统图标一样。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise it takes the menu bar’s one color, as the system’s icons do."
          }
        }
      }
    },
