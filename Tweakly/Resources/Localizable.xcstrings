    "“%@” could not be added: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht hinzugefügt werden: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”を追加できませんでした：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» не добавлен: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法添加“%@”：%@"
          }
        }
      }
    },
    "“%@” could not be checked safely, so it was not added.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht sicher geprüft werden und wurde daher nicht hinzugefügt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”を安全に確認できなかったため、追加しませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл «%@» не удалось безопасно проверить, поэтому он не добавлен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全地检查“%@”，因此未添加。"
          }
        }
      }
    },
    "“%@” could not be played. It may be damaged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht abgespielt werden. Die Datei ist eventuell beschädigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”を再生できませんでした。破損している可能性があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось воспроизвести «%@». Возможно, файл повреждён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法播放“%@”。它可能已损坏。"
          }
        }
      }
    },
    "“%@” did not quit. Save your work in it, quit it and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde nicht beendet. Sichere deine Arbeit darin, beende die App und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”が終了しませんでした。作業内容を保存して終了してから、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%@» не закрылось. Сохраните в нём работу, закройте его и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”未退出。请在其中保存你的工作，将其退出后再试一次。"
          }
        }
      }
    },
    "“%@” is larger than 8K, which no Mac screen needs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist größer als 8K, was kein Mac-Bildschirm benötigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は8Kを超えています。それほどの解像度が必要なMacの画面はありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» больше 8K, ни одному экрану Mac столько не нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”超过8K，任何Mac屏幕都用不到这么高的分辨率。"
          }
        }
      }
    },
    "“%@” is not a video or picture this Mac can show.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist weder ein Video noch ein Bild, das dieser Mac anzeigen kann."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は、このMacで表示できるビデオや画像ではありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не видео и не картинка, которые этот Mac может показать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是这台Mac可以显示的视频或图片。"
          }
        }
      }
    },
    "“%@” is open. Tweakly will quit it first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist geöffnet. Tweakly beendet die App zuerst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”が開いています。Tweaklyが先にこのアプリを終了します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%@» открыто. Tweakly сначала закроет его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已打开。Tweakly会先将其退出。"
          }
        }
      }
    },
    "“%@” is protected and plays only in the app it came from.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist geschützt und kann nur in der App abgespielt werden, aus der es stammt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は保護されているため、入手元のアプリでしか再生できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» защищён и воспроизводится только в своём приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”受保护，只能在其来源App中播放。"
          }
        }
      }
    },
    "“%@” is shorter than a second.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kürzer als eine Sekunde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は1秒未満です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» короче секунды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不足1秒。"
          }
        }
      }
    },
    "“%@” is too small for a desktop picture.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist zu klein für ein Hintergrundbild."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は壁紙にするには小さすぎます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» слишком мал для рабочего стола."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”太小，无法用作桌面图片。"
          }
        }
      }
    },
    "“%@” keeps no files of its own outside the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat außerhalb der App keine eigenen Dateien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”はアプリの外に独自のファイルを保存していません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%@» нет своих файлов за пределами приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”在App之外没有自己的文件。"
          }
        }
      }
    },
    "“%@” uses %@, which this Mac decodes only with its processor. As a wallpaper it would use a lot of power.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verwendet %@, das dieser Mac nur mit dem Prozessor decodiert. Als Hintergrundbild würde es viel Energie verbrauchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は%@を使用していますが、このMacではプロセッサでしかデコードできません。壁紙にすると電力を多く消費します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» в формате %2$@, который этот Mac расшифровывает только процессором. Как обои он тратил бы много энергии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”采用%@编码，这台Mac只能用处理器解码。用作墙纸会耗费大量电量。"
          }
        }
      }
    },
