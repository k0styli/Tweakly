    "Press %@ to see what is slowing your Mac down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke %@, um zu sehen, was deinen Mac ausbremst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押すと、Macの動作を遅くしているものを確認できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@, чтобы увидеть, что тормозит Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下%@即可查看是什么让Mac变慢。"
          }
        }
      }
    },
    "Press %@ wherever you are to see what is slowing your Mac down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke %@ in jeder App, um zu sehen, was deinen Mac ausbremst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこからでも%@を押すと、Macの動作を遅くしているものを確認できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@ где угодно, чтобы увидеть, что тормозит Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论在哪里，按下%@即可查看是什么让Mac变慢。"
          }
        }
