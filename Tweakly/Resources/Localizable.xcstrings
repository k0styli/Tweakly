    "Favorites, files you added and what is on a display stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten, von dir hinzugefügte Dateien und alles, was auf einem Display angezeigt wird, bleiben erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り、追加したファイル、ディスプレイに設定中のものは残ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранное, ваши файлы и то, что стоит на дисплее, останутся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人收藏、你添加的文件以及显示器上正在显示的内容会保留。"
          }
        }
      }
    },
    "Files & Folders": {
      "localizations": {
        "de": {
