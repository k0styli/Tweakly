    "New File on the desktop and in Documents and Downloads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Neue Datei“ auf dem Schreibtisch und in „Dokumente“ und „Downloads“."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ、“書類”、“ダウンロード”での“新規ファイル”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Новый файл» на рабочем столе, в «Документах» и «Загрузках»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面、“文稿”和“下载”中“新建文件”。"
          }
        }
      }
    },
    "No acceleration, the wheel as on Windows, side buttons": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Beschleunigung, Mausrad wie unter Windows, Seitentasten"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "加速なし、Windowsのようなホイール、サイドボタン"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ускорения, колесо как в Windows, боковые кнопки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无加速、类似Windows的滚轮、侧边按钮"
          }
        }
      }
    },
    "Not Allowed": {
      "localizations": {
        "de": {
