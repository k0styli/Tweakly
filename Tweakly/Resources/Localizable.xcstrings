    "If Tweakly already looks on in System Settings, turn it off and on again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Tweakly in den Systemeinstellungen bereits aktiviert scheint, deaktiviere es und aktiviere es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“システム設定”でTweaklyがすでにオンになっているように見える場合は、一度オフにしてから再度オンにしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если в Системных настройках Tweakly уже выглядит включённым, выключите и снова включите его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
