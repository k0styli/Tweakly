    "Universal": {
      "comment": "Kind of an app, as in System Settings",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Universal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユニバーサル"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальное"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
