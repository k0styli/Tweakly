            "value": "程序坞预览"
          }
        }
      }
    },
    "Hide": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausblenden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏"
          }
        }
      }
    },
    "Hide App": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App ausblenden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを非表示"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть приложение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏App"
          }
        }
      }
    },
    "Hold the pointer on an app in the Dock to see its windows. A click on the app in front minimizes it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den Zeiger auf einer App im Dock ruhen, um ihre Fenster zu sehen. Ein Klick auf die App im Vordergrund legt sie im Dock ab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockのアプリにポインタを置くと、そのウインドウが表示されます。最前面にあるアプリをクリックすると、ウインドウをしまいます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержите указатель на приложении в Dock, чтобы увидеть его окна. Клик по приложению на переднем плане сворачивает его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针停留在程序坞中的App上即可查看其窗口。点按最前面的App会将其最小化。"
          }
        }
      }
    },
    "How long the pointer rests on an icon before its windows appear.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange der Zeiger auf einem Symbol ruht, bevor die Fenster der App erscheinen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが表示されるまで、ポインタをアイコン上に置いておく時間です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько указатель должен пробыть на значке, прежде чем появятся окна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针在图标上停留多久后显示其窗口。"
          }
        }
      }
    },
    "Minimize Windows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster im Dock ablegen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウをしまう"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свернуть окна"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最小化窗口"
          }
        }
      }
    },
    "Of the app in front, while one of its windows is in sight. Other clicks work as usual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für die App im Vordergrund, solange eines ihrer Fenster sichtbar ist. Andere Klicks funktionieren wie gewohnt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最前面にあるアプリのウインドウが見えているときに適用されます。それ以外のクリックは通常どおり動作します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По приложению на переднем плане, пока видно его окно. Остальные клики работают как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于最前面的App，且其窗口可见时。其他点按照常工作。"
          }
        }
      }
    },
    "Off until Accessibility is allowed. The Dock works as usual until then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet, bis der Zugriff auf die Bedienungshilfen erlaubt ist. Bis dahin funktioniert das Dock wie gewohnt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティが許可されるまではオフです。それまでDockは通常どおり機能します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено, пока не разрешён универсальный доступ. До тех пор Dock работает как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“无障碍”权限之前处于关闭状态。在此之前，程序坞照常工作。"
          }
        }
      }
    },
    "Pictures are shared with Command-Tab, so a window seen in one appears at once in the other.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bilder werden mit Befehl-Tab gemeinsam genutzt: Ein Fenster, das in einem zu sehen war, erscheint sofort auch im anderen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの画像はCommand＋Tabと共有されるため、一方で表示したウインドウはもう一方にもすぐに表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимки общие с Command-Tab: окно, снятое в одном, сразу видно в другом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快照与Command-Tab共享，因此在其中一处看过的窗口会立即出现在另一处。"
          }
        }
      }
    },
    "Short": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткая"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短"
          }
        }
      }
    },
    "Show Previews on Hover": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschauen beim Darüberbewegen zeigen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを置いたときにプレビューを表示"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать превью при наведении"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停时显示预览"
          }
        }
      }
    },
    "Windows over each Dock icon, and a click to minimize": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster über jedem Dock-Symbol und Ablegen im Dock per Klick"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockアイコンの上にウインドウを表示し、クリックでしまう"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна над значками Dock и сворачивание кликом"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在程序坞图标上方显示窗口，点按即可最小化"
          }
        }
      }
    },
    "Without Screen Recording the previews show app icons and window titles.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Bildschirmaufnahme zeigen die Vorschauen App-Symbole und Fenstertitel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録が許可されていない場合、プレビューにはアプリのアイコンとウインドウのタイトルが表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без записи экрана в превью будут значки приложений и названия окон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有录屏权限时，预览将显示App图标和窗口标题。"
          }
        }
      }
    },
    "Finder Menu": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder-Menü"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderメニュー"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达菜单"
          }
        }
      }
    },
    "More in Finder’s Shortcut Menu": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr im Finder-Kontextmenü"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderのショートカットメニューに項目を追加"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше пунктов в контекстном меню Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达快捷菜单中的更多项目"
          }
        }
      }
    },
    "New File, Copy Path and Open in Terminal with a right click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Neue Datei“, „Pfad kopieren“ und „In Terminal öffnen“ per Rechtsklick."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右クリックで、新規ファイルの作成、パスのコピー、“ターミナル”で開く操作ができます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Новый файл», «Скопировать путь» и «Открыть в Терминале» по правому клику."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按即可使用“新建文件”、“拷贝路径”和“在终端中打开”。"
          }
        }
      }
    },
    "New File, Copy Path and Open in Terminal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Neue Datei“, „Pfad kopieren“ und „In Terminal öffnen“"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規ファイル、パスをコピー、“ターミナル”で開く"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый файл, путь и Терминал по правому клику"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“新建文件”、“拷贝路径”和“在终端中打开”"
          }
        }
      }
    },
    "New File": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Datei"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規ファイル"
          }
        },
        "ru": {
          "stringUnit": {
