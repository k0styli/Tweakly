    "Find Any Setting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Einstellung finden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの設定もすぐに見つかる"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любая настройка в поиске"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找任何设置"
          }
        }
      }
    },
    "Finder cannot dim cut files, so a small label says how many were cut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder kann ausgeschnittene Dateien nicht abblenden, daher zeigt ein kleiner Hinweis, wie viele ausgeschnitten wurden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderではカットしたファイルを淡色表示できないため、カットした数を小さなラベルで表示します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder не умеет затемнять вырезанные файлы, поэтому небольшая подпись показывает, сколько их вырезано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达无法让已剪切的文件变暗显示，因此会用一个小标签显示剪切了多少个文件。"
          }
        }
      }
    },
    "Finds the data of apps from the App Store. Optional.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet die Daten von Apps aus dem App Store. Optional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeのアプリのデータを見つけます。任意です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит данные приложений из App Store. Необязательно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
