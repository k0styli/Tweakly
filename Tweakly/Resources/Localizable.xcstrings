    "%@ is running. Two apps setting the fans overwrite each other.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird ausgeführt. Zwei Apps, die die Lüfter steuern, überschreiben sich gegenseitig."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が実行中です。2つのアプリがファンを設定すると、互いの設定が上書きされます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущен %@. Два приложения, управляющие кулерами, перебивают друг друга."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@正在运行。两个App同时设置风扇会互相覆盖。"
          }
        }
      }
    },
