    "Tweakly needs an administrator’s password to end a process of another user.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweakly benötigt ein Administratorpasswort, um einen Prozess eines anderen Benutzeraccounts zu beenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweaklyがほかのユーザのプロセスを終了するには、管理者パスワードが必要です。"
          }
        },
        "ru": {
          "stringUnit": {
