          }
        }
      }
    },
    "“%@” belongs to macOS or another user. Ending it can stop macOS or other apps from working until you restart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ gehört zu macOS oder einem anderen Benutzeraccount. Wenn du den Prozess beendest, funktionieren macOS oder andere Apps eventuell erst nach einem Neustart wieder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”はmacOSまたはほかのユーザに属しています。終了すると、再起動するまでmacOSやほかのアプリが動作しなくなる場合があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» принадлежит macOS или другому пользователю. Если его завершить, macOS или другие приложения могут перестать работать до перезагрузки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”属于macOS或其他用户。结束它可能会导致macOS或其他App无法正常工作，直到你重新启动。"
          }
        }
      }
    },
