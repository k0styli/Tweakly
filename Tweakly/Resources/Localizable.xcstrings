    "Off until Accessibility is allowed. Command-Tab works as usual until then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet, bis der Zugriff auf die Bedienungshilfen erlaubt ist. Bis dahin funktioniert Befehl-Tab wie gewohnt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティが許可されるまではオフです。それまでCommand＋Tabは通常どおり機能します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено, пока не разрешён универсальный доступ. До тех пор Command-Tab работает как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“无障碍”权限之前处于关闭状态。在此之前，Command-Tab照常工作。"
          }
        }
      }
    },
    "Off until Accessibility is allowed. Command-X works as usual until then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet, bis der Zugriff auf die Bedienungshilfen erlaubt ist. Bis dahin funktioniert Befehl-X wie gewohnt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティが許可されるまではオフです。それまでCommand＋Xは通常どおり機能します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено, пока не разрешён универсальный доступ. До тех пор Command-X работает как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“无障碍”权限之前处于关闭状态。在此之前，Command-X照常工作。"
          }
        }
      }
    },
