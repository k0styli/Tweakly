    "0 % is the slowest a fan can spin, not standing still.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 % ist die niedrigste Drehzahl eines Lüfters, nicht der Stillstand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0%はファンが停止する値ではなく、ファンが回転できる最低の回転数です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "0 % это самая низкая скорость кулера, а не остановка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0%是风扇所能达到的最低转速，并非停转。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0% is the slowest a fan can spin, not standing still."
          }
        }
      }
    },
