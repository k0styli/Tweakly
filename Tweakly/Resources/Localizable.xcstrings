    "A video always stops while the screen is locked or the display sleeps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Video wird immer angehalten, während der Bildschirm gesperrt ist oder sich das Display im Ruhezustand befindet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面がロックされているときやディスプレイがスリープしているときは、ビデオは常に停止します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео всегда останавливается, пока экран заблокирован или дисплей спит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕锁定或显示器睡眠时，视频总会停止播放。"
          }
        }
      }
    },
    "Add…": {
      "localizations": {
        "de": {
